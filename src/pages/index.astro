---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE, REGIONS, DIFFICULTY } from '../site';
import { img } from '../lib/img';

const routes = (await getCollection('routes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const places = (await getCollection('places', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const n = routes.length;
const pad = (i: number) => String(i).padStart(2, '0');
const fmt = (min: number) => { const h = Math.floor(min / 60), m = min % 60; return { h, m }; };

// 이번 주 추천: 가장 최근 루트
const pick = routes[0];
const pd = pick?.data;
const pt = pd ? fmt(pd.durationMin) : { h: 0, m: 0 };
const firstWp = pd?.waypoints[0];
const coord = firstWp ? `${firstWp.lat.toFixed(3)}° N  ${firstWp.lng.toFixed(3)}° E` : '';
const heroArt = img(routes[1]?.data.cover ?? pd?.cover, 1400);
const featureRoute = routes.find((r) => r.data.region === 'gangwon') ?? routes[1] ?? pick;
---
<Base image={img(pd?.cover, 1200)}>
  <section class="hero-ed">
    <div class="wrap">
      <h1 class="title"><span>RIDING</span><span>ROAD</span></h1>
      <div class="grid">
        <div>
          <p class="sub">The road isn't the limit</p>
          <p class="lead">경유지, 거리, 소요시간, 휴게 포인트까지 지도 위에. 라이더 카페를 중심으로 짜고 영업 여부까지 확인한 수도권·강원 투어 코스 {n}개.</p>
          <a class="arrow-link" href="/routes/">루트 둘러보기</a>

          {pd && (
            <div class="blue-card">
              <span class="star">✦</span>
              <span class="eyebrow">This week's route</span>
              <h3><a href={`/routes/${pick.id}/`}>{pd.title}</a></h3>
              <div class="stats">
                <div><b>{pd.distanceKm}</b><span>km</span></div>
                <div><b>{pt.h}</b><span>hrs</span></div>
                <div><b>{pad(pt.m)}</b><span>mins</span></div>
                <div><b>{pd.waypoints.length}</b><span>stops</span></div>
              </div>
              <a class="more" href={`/routes/${pick.id}/`}>Open</a>
            </div>
          )}
          <div class="tag">Motorcycle touring · Korea</div>
        </div>
        <div class="art">
          {heroArt && <img class="mono cutout" src={heroArt} alt="" loading="eager" />}
        </div>
      </div>
      <div class="scroll-tab">Scroll to discover</div>

      <div class="steps">
        <div class="step"><span class="n">01</span><span class="t">루트<br />고르기</span></div>
        <div class="step"><span class="n">02</span><span class="t">경유지·영업시간<br />확인</span></div>
        <div class="step"><span class="n">03</span><span class="t">내비에 넣고<br />출발</span></div>
        <div class="thumb">{routes[2]?.data.cover && <img class="mono" src={img(routes[2].data.cover, 600)} alt="" loading="lazy" />}</div>
      </div>
    </div>
  </section>

  <section class="ed-section">
    <div class="wrap">
      <div class="ed-head">
        <div>
          <span class="eyebrow">All routes</span>
          <h2>직접 달려보고<br />고른 길 {pad(n)}</h2>
        </div>
        <p>지역과 난이도로 고르세요. 모든 코스는 지도, 경유지, 휴게 포인트, 영업 확인 날짜가 함께 정리되어 있습니다.</p>
      </div>
      <div class="route-list">
        {routes.map((r, i) => {
          const d = r.data; const t = fmt(d.durationMin);
          return (
            <a class="route-row" href={`/routes/${r.id}/`}>
              <span class="n">{pad(i + 1)}</span>
              <div>
                <h3>{d.title}</h3>
                <div class="meta">{REGIONS[d.region]} · {DIFFICULTY[d.difficulty].label} · <b>{d.distanceKm} km</b> · {t.h}h {pad(t.m)}m · {d.waypoints.length} stops</div>
              </div>
              <div class="pic">{d.cover && <img class="mono" src={img(d.cover, 700)} alt="" loading="lazy" />}</div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="wrap">
    <div class="feature">
      <div>
        <span class="eyebrow">Our mission</span>
        <h2>지도 앱이 알려주지 않는 것을<br />라이더 시점에서 기록합니다</h2>
        <p>어느 코너에 모래가 쌓이는지, 어디에 바이크를 세우기 편한지, 몇 시에 가야 안 막히는지. 라이더 카페를 중심으로 코스를 짜고, 올리기 전에 영업 여부를 다시 확인합니다.</p>
        <a class="arrow-link" href="/about/">더 알아보기</a>
        {firstWp && (
          <div class="caption">
            {pd?.cover && <img class="mono" src={img(pd.cover, 200)} alt="" loading="lazy" />}
            <span class="coord">{coord}</span>
            <span>◎</span>
          </div>
        )}
      </div>
      <div class="blue-img">
        {featureRoute?.data.cover && <img class="mono" src={img(featureRoute.data.cover, 1000)} alt="" loading="lazy" />}
      </div>
      <div class="feat-list">
        <div class="feat-item"><div class="ico">◈</div><h3>Rider cafés first</h3><p>라이더 성지로 불리는 카페를 기준점으로 코스를 설계합니다.</p></div>
        <div class="feat-item"><div class="ico">◎</div><h3>Verified open</h3><p>올리기 전 최근 후기와 지도 영업 정보를 교차 확인하고 날짜를 적습니다.</p></div>
        <div class="feat-item"><div class="ico">↗</div><h3>Nav-ready</h3><p>경유지 순서 그대로 내비게이션에 넣으면 끝. 좌표까지 제공합니다.</p></div>
      </div>
    </div>
  </section>

  <section class="ed-section wrap" style="padding-bottom: 20px">
    <div class="ed-head">
      <div>
        <span class="eyebrow">Places</span>
        <h2>라이더를 위한 장소</h2>
      </div>
      <a class="arrow-link" href="/places/">전체 보기</a>
    </div>
    <div class="places-strip">
      {places.slice(0, 4).map((p) => (
        <a href={`/places/${p.id}/`}>
          {p.data.cover && <div class="ed-photo ph"><img src={img(p.data.cover, 500)} alt="" loading="lazy" /></div>}
          <span class="k">{REGIONS[p.data.region]}</span>
          <div><h3>{p.data.title}</h3><div class="s">{p.data.summary}</div></div>
        </a>
      ))}
    </div>
  </section>
</Base>
