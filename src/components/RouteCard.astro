---
import type { CollectionEntry } from 'astro:content';
import { REGIONS, DIFFICULTY } from '../site';
interface Props { route: CollectionEntry<'routes'> }
const { route } = Astro.props;
const d = route.data;
const hours = Math.floor(d.durationMin / 60);
const mins = d.durationMin % 60;
const duration = hours ? `${hours}시간${mins ? ` ${mins}분` : ''}` : `${mins}분`;
---
<a class="card" href={`/routes/${route.id}/`} data-region={d.region} data-difficulty={d.difficulty}>
  <div class="thumb">
    {d.cover && <img src={d.cover} alt="" loading="lazy" />}
    <span class="region">{REGIONS[d.region]}</span>
  </div>
  <div class="body">
    <h3>{d.title}</h3>
    <p class="summary">{d.summary}</p>
    <div class="tags">
      <span class:list={['diff', d.difficulty]}>{DIFFICULTY[d.difficulty].label}</span>
      {d.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
    </div>
    <div class="stats">
      <span><b>{d.distanceKm}</b> km</span>
      <span><b>{duration}</b> 주행</span>
      <span>{d.waypoints.length}개 경유지</span>
    </div>
  </div>
</a>
