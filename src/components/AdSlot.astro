---
/**
 * 광고 자리. AdSense 승인 전에는 점선 박스만 보이고,
 * 승인 후 site.ts의 adsenseClient와 여기 slot 번호를 채우면 실제 광고가 나옵니다.
 */
import { SITE } from '../site';
interface Props { slot?: string; shape?: 'banner' | 'rect'; }
const { slot = '', shape = 'banner' } = Astro.props;
const live = SITE.adsenseClient && slot;
---
{live ? (
  <ins class="adsbygoogle" style="display:block" data-ad-client={SITE.adsenseClient} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
  <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
) : (
  <div class:list={['ad-slot', shape]} aria-hidden="true">광고 영역 ({shape === 'rect' ? '300×250' : '반응형 배너'})</div>
)}
